# ed25519 keys are in known_hosts under the MagicDNS name.
Host r630a r630a.zeedonk-ostrich.ts.net
    HostName r630a.zeedonk-ostrich.ts.net
    User milc
    AddressFamily inet
    CheckHostIP no
    IdentityFile ~/.ssh/id_ed25519
