<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dl-alexandre.aerospace-autobalance</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/developer/.local/bin/aerospace-autobalance.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/aerospace-autobalance.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/aerospace-autobalance.err</string>
    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
